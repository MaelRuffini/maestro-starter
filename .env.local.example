# Copied to .env.local by `npm run setup`. All variables are optional for a public
# Prismic repository; the repository name itself lives in prismic.config.json.

# Only if the Prismic API is set to "private" in the repository settings.
# Create one with: npx prismic token create --name "Next.js" (or in Settings → API & Security)
PRISMIC_ACCESS_TOKEN=

# Write token (Settings → API & Security). Required for `npm run prismic:fill`.
# Never commit the real value. Never use this to auto-publish.
PRISMIC_WRITE_TOKEN=

# Point the app at a Prismic environment (e.g. "my-site-staging") instead of the
# production repository from prismic.config.json.
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=

# Canonical origin for /sitemap.xml and /robots.txt. Optional.
# On Vercel the project's production domain is used when this is unset.
# Locally the sitemap uses http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Slack Socket Mode (`npm run slack`) — client talks here, Cursor cloud agent builds.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
CURSOR_API_KEY=
CURSOR_CLOUD_REPO=
CURSOR_CLOUD_REF=main

