---
/**
 * Renders a document's `slices` array. Registry: src/slices/index.js.
 * Unknown `_type` is skipped (a stale document after a slice rename).
 *
 * Astro dynamic components: import the map statically via the registry
 * that scaffold keeps up to date. If the registry uses lazy import(),
 * resolve them before the template (see BUILD.md phase 3).
 */
import { components } from "@/slices/index.js";

const { slices = [] } = Astro.props;
---

{
  slices.map((slice) => {
    const Cmp = components[slice._type];
    if (!Cmp) return null;
    return <Cmp slice={slice} />;
  })
}
