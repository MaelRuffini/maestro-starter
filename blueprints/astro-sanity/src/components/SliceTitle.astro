---
/**
 * Slice lockup title. The first Portable Text block's `style` is the
 * heading tag; `class` is the size (.h2, .display, …). Extra blocks
 * become <br> lines, not sibling headings.
 *
 * Motion: spread animate("title") unless animation={false}.
 */
import { animate } from "@/lib/animate.js";
import { isFilled } from "@/lib/filled.js";
import "@/styles/components/slice-title.scss";

const { field, class: className, fallbackTag = "h2", animation } = Astro.props;

const blocks = Array.isArray(field) ? field : [];
const first = blocks[0];
const tagFromStyle = first?.style && /^h[1-6]$/.test(first.style) ? first.style : null;
const Tag = tagFromStyle || fallbackTag;
const lines = blocks.map((block) =>
  (block.children ?? []).map((child) => child.text ?? "").join(""),
);
const motion = animation === false ? {} : animate(animation || "title");
---

{
  isFilled.portable(field) && (
    <Tag class:list={["slice-title", className]} {...motion}>
      {lines.map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </Tag>
  )
}
