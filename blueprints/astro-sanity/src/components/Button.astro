---
import { resolveHref } from "@/lib/links.js";

const { link, class: className } = Astro.props;
const href = resolveHref(link);
const variant = (link?.variant ?? "Primary").toLowerCase();
const modifier =
  variant === "primary" ? undefined : `button--${variant}`;
---

{
  href && link?.label && (
    <a href={href} class:list={["button", modifier, className]}>
      {link.label}
    </a>
  )
}
