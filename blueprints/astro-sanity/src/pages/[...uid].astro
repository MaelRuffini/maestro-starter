---
import Layout from "@/layouts/Layout.astro";
import PageBuilder from "@/components/PageBuilder.astro";
import { loadQuery } from "@/lib/load-query.js";
import { pageBySlugQuery } from "@/lib/queries.js";

const slug = Astro.params.uid;
const { data: page } = await loadQuery({
  query: pageBySlugQuery,
  params: { slug },
});

if (!page) {
  return Astro.redirect("/404");
}
---

<Layout title={page.seo?.meta_title || page.title} description={page.seo?.meta_description}>
  <PageBuilder slices={page.slices} />
</Layout>
