---
/**
 * Template copied by slice:scaffold --from, or used as the blank start.
 * Rename the BEM block, fields, and the Reference line.
 */
import SliceSection from "@/components/SliceSection.astro";
import SliceTitle from "@/components/SliceTitle.astro";
import { isFilled } from "@/lib/filled.js";
import "./slice-template.scss";

const { slice } = Astro.props;
const modifier =
  slice.variation && slice.variation !== "default"
    ? `slice-template--${slice.variation}`
    : undefined;
---

<SliceSection slice={slice} class={modifier} wrapperClass="slice-template__wrapper">
  {isFilled.portable(slice.title) && (
    <SliceTitle field={slice.title} class="slice-template__title h2" />
  )}
</SliceSection>
