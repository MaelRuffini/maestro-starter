---
/**
 * Site chrome. Port of src/app/layout.js.
 * Copy fonts / metadata helpers during BUILD.md phase 1 + 8.
 */
import SmoothScroll from "@/components/SmoothScroll.jsx";
import Animations from "@/components/Animations.jsx";
import GridOverlay from "@/components/GridOverlay.jsx";
import { getSiteDefaults } from "@/lib/site.js";
import "@/styles/global.scss";

const { title, description } = Astro.props;
const site = getSiteDefaults();
const pageTitle = title ? `${title} — ${site.name}` : site.name;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <!-- CustomCode head slot (BUILD.md phase 8) -->
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <!-- CustomCode body-start if needed -->
    <main id="main">
      <slot />
    </main>
    <GridOverlay client:idle />
    <SmoothScroll client:load />
    <Animations client:load />
    <!-- VisualEditing enabled={PUBLIC_SANITY_VISUAL_EDITING_ENABLED} -->
    <!-- CustomCode body-end -->
  </body>
</html>
