{
  "name": "maestro-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint && npm run lint:css --silent && npm run slice:check --silent",
    "lint:css": "stylelint \"src/**/*.scss\" \"examples/**/*.scss\"",
    "slice:check": "node scripts/slice-check.mjs --examples",
    "setup": "node scripts/init.mjs",
    "slice:scaffold": "node scripts/slice-scaffold.mjs",
    "slice:land": "node scripts/slice-land.mjs",
    "type:install": "node scripts/type-install.mjs",
    "sanity:connect": "node scripts/sanity-connect.mjs",
    "sanity:fill": "node scripts/sanity-fill-slice.mjs",
    "slack": "node scripts/slack-maestro.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6",
    "@astrojs/vercel": "^9",
    "@portabletext/astro": "^0",
    "@sanity/astro": "^3.5.0",
    "@sanity/client": "^7",
    "@sanity/image-url": "^2",
    "@sanity/preview-url-secret": "^2",
    "@sanity/visual-editing": "^3",
    "astro": "^7",
    "groq": "^4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "plyr": "^3.8.4",
    "react": "^19",
    "react-dom": "^19",
    "sanity": "^4"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.31",
    "@slack/bolt": "^4.7.3",
    "eslint": "^9",
    "sass": "^1.104.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1"
  }
}
